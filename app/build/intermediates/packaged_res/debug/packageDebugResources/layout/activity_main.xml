<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <!-- 1. Background Image: Provided purple ribbon wallpaper with aspect-ratio preserved -->
    <ImageView
        android:id="@+id/img_wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Wallpaper"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_tv_wallpaper" />

    <!-- 2. Main Content Stack -->
    <RelativeLayout
        android:id="@+id/main_content_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingTop="30dp"
        android:paddingBottom="48dp">

        <!-- TOP HEADER: Greeting, Date/Time & Segoe MDL2 Status Icons -->
        <RelativeLayout
            android:id="@+id/header_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="64dp"
            android:paddingEnd="64dp">

            <!-- Header Left: Greeting & Date/Time in Segoe UI -->
            <LinearLayout
                android:id="@+id/header_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/segoeui"
                    android:text="@string/greeting_morning"
                    android:textColor="@color/white"
                    android:textSize="38sp"
                    android:textStyle="normal" />

                <!-- Current Weather in Aluva, Kerala between Greeting and Date/Time -->
                <TextView
                    android:id="@+id/tv_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/segoeui"
                    android:text="⛅ 26°C • Aluva, Kerala"
                    android:textColor="@color/white_80"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_datetime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/segoeui"
                    android:text="@string/default_datetime"
                    android:textColor="@color/white_80"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- Header Right: Raw Wi-Fi and Settings Glyphs (No Box, Lights up on focus) -->
            <LinearLayout
                android:id="@+id/header_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Wi-Fi Status Glyph -->
                <TextView
                    android:id="@+id/btn_wifi"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@null"
                    android:clickable="true"
                    android:contentDescription="Wi-Fi Settings"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/segmdl2"
                    android:gravity="center"
                    android:nextFocusLeft="@+id/btn_wifi"
                    android:nextFocusRight="@+id/btn_settings"
                    android:nextFocusDown="@+id/grid_row_1"
                    android:text="&#xE701;"
                    android:textColor="@color/white_80"
                    android:textSize="26sp" />

                <!-- Settings Cogwheel Glyph -->
                <TextView
                    android:id="@+id/btn_settings"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:clickable="true"
                    android:contentDescription="TV Settings"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="@font/segmdl2"
                    android:gravity="center"
                    android:nextFocusLeft="@+id/btn_wifi"
                    android:nextFocusRight="@+id/btn_settings"
                    android:nextFocusDown="@+id/grid_row_1"
                    android:text="&#xE713;"
                    android:textColor="@color/white_80"
                    android:textSize="26sp" />

            </LinearLayout>

        </RelativeLayout>

        <!-- STRICTLY TWO HORIZONTAL ROWS (With ~1cm bottom spacing) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/header_layout"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- ROW 1: Main Apps (YouTube, Prime Video, Netflix, Music app) -->
            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/grid_row_1"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="64dp"
                android:paddingEnd="120dp" />

            <!-- ROW 2: All Other Apps -->
            <androidx.leanback.widget.HorizontalGridView
                android:id="@+id/grid_row_2"
                android:layout_width="match_parent"
                android:layout_height="156dp"
                android:layout_marginTop="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="64dp"
                android:paddingEnd="120dp" />

        </LinearLayout>

    </RelativeLayout>

    <!-- 3. Ambient Screensaver Layer (Windows 10 Lock Screen Aesthetic) -->
    <FrameLayout
        android:id="@+id/ambient_screensaver_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <!-- Full-screen Wallpaper with Cover Sizing -->
        <ImageView
            android:id="@+id/img_ambient_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Ambient Wallpaper"
            android:scaleType="centerCrop"
            android:src="@drawable/bg_tv_wallpaper" />

        <!-- Subtle vignette / gradient for maximum typography readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#26000000" />

        <!-- Top-Right Attribution (Windows 10 Spotlight Style) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="56dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_ambient_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/segoeui"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="Bing Daily Wallpaper"
                android:textColor="@color/white"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tv_ambient_copyright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/segoeui"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="Windows 10 Lock Screen"
                android:textColor="@color/white_80"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Bottom-Left: Windows 10 Prominent Clock & Date (Closer to left-bottom corner with reduced gap) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="44dp"
            android:layout_marginBottom="32dp"
            android:orientation="vertical">

            <!-- 12-Hour Clock with AM/PM (e.g. 1:45 PM) in clean Segoe UI -->
            <TextView
                android:id="@+id/tv_ambient_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/segoeui"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="4"
                android:shadowRadius="12"
                android:text="1:45 PM"
                android:textColor="@color/white"
                android:textSize="80sp" />

            <!-- Readable Date (e.g. Wednesday, 21 October) directly tucked below time -->
            <TextView
                android:id="@+id/tv_ambient_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:fontFamily="@font/segoeui"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="3"
                android:shadowRadius="8"
                android:text="Wednesday, 21 October"
                android:textColor="@color/white"
                android:textSize="23sp" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
