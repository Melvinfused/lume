<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile_root"
    android:layout_width="250dp"
    android:layout_height="140dp"
    android:layout_marginEnd="16dp"
    android:background="@drawable/bg_acrylic_tile_dark"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <!-- Transparent Dark Acrylic Tile Content -->
    <RelativeLayout
        android:id="@+id/tile_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="14dp">

        <!-- Centered Projectivy App Icon (transparent background) -->
        <ImageView
            android:id="@+id/img_app_logo"
            android:layout_width="130dp"
            android:layout_height="64dp"
            android:layout_centerInParent="true"
            android:adjustViewBounds="true"
            android:contentDescription="App Logo"
            android:scaleType="fitCenter" />

        <!-- App Name Label at Bottom-Left with Segoe UI -->
        <TextView
            android:id="@+id/txt_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:ellipsize="end"
            android:fontFamily="@font/segoeui"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="normal" />

    </RelativeLayout>

</FrameLayout>
