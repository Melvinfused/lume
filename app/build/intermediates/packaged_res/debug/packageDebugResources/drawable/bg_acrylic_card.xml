<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused Acrylic State -->
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#35FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <stroke
                        android:width="3.5dp"
                        android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal Acrylic State -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <solid android:color="#18FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="3dp" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#35FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
