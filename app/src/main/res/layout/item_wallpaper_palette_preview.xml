<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/palette_card_root"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="@drawable/bg_header_button"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="68dp"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Swatch box: Inner tile color with accent stroke -->
    <View
        android:id="@+id/palette_swatch"
        android:layout_width="32dp"
        android:layout_height="18dp"
        android:layout_marginBottom="4dp" />

    <!-- Theme Name -->
    <TextView
        android:id="@+id/txt_palette_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/segoeui"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Active Indicator / Subtitle -->
    <TextView
        android:id="@+id/txt_palette_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/segoeui"
        android:gravity="center"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/white_60"
        android:textSize="9sp" />

</LinearLayout>
