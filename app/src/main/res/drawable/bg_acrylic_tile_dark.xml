<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Same background color, only white focus border added -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#4D090E1A" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Pressed state: Same background color, only white focus border added -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#4D090E1A" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Default state: Transparent dark acrylic tint without border lines -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#4D090E1A" />
        </shape>
    </item>
</selector>
