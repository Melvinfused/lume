<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: Radiant pure white border with acrylic dark fill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#730C1322" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#99141D30" />
            <stroke android:width="3dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Default state: Transparent dark acrylic tint with subtle border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#4D090E1A" />
            <stroke android:width="1.2dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
</selector>
